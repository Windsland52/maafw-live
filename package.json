{
  "name": "@windsland52/maa-live",
  "version": "0.2.0",
  "description": "MaaFramework 设备交互与实时观测底座：常驻 daemon + 可复用客户端 + 确定性 CLI。不绑定宿主。",
  "type": "module",
  "bin": {
    "maafw-live": "bin/maafw-live.mjs"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "bin",
    "lib",
    "docs",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Windsland52/maafw-live.git"
  },
  "homepage": "https://github.com/Windsland52/maafw-live#readme",
  "bugs": {
    "url": "https://github.com/Windsland52/maafw-live/issues"
  },
  "keywords": [
    "maaframework",
    "maa",
    "automation",
    "agent",
    "adb",
    "win32",
    "cli",
    "daemon"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/daemon.d.ts",
      "default": "./lib/client/daemon.js"
    },
    "./actions": {
      "types": "./lib/types/runtime/actions.d.ts",
      "default": "./lib/runtime/actions.js"
    },
    "./keyframes": {
      "types": "./lib/types/runtime/keyframes.d.ts",
      "default": "./lib/runtime/keyframes.js"
    },
    "./image": {
      "types": "./lib/types/image.d.ts",
      "default": "./lib/image.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-daemon.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node scripts/verify-cli.mjs",
    "test": "npm run build && node scripts/run-tests.mjs",
    "accept:offline": "node scripts/accept-kf-offline.mjs",
    "accept:crop": "node scripts/accept-crop-fromkf.mjs",
    "survey:crop": "node scripts/survey-crop.mjs",
    "survey:som": "node scripts/survey-som.mjs",
    "accept": "node scripts/accept-emulator.mjs"
  },
  "dependencies": {
    "@maaxyz/maa-node": "^5.14.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  }
}
